# LandingSentinel — environment configuration
#
# Copy this file to .env.local (development) or .env (production):
#   cp .env.example .env.local
#
# Full documentation for every variable: CONFIGURATION.md
# Variables prefixed NEXT_PUBLIC_ are inlined into the client build —
# changing them requires a rebuild (npm run build). Server-only
# variables are read at runtime.

# ------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------
# SQLite file for the bundled development/demo setup. The file is
# created by `npm run db:push` relative to the prisma/ directory.
#
# For production PostgreSQL (Neon, Supabase, or any hosted Postgres):
#  1. Change the datasource provider to "postgresql" in prisma/schema.prisma
#  2. Set DATABASE_URL to your connection string, e.g.
#     postgresql://user:password@host/dbname?sslmode=require
#  3. Run `npm run db:push` (or `npm run db:migrate`) against the new database
# See DEPLOYMENT.md before switching.
DATABASE_URL=file:./db/custom.db

# ------------------------------------------------------------------
# Runtime modes (server-only)
# ------------------------------------------------------------------
# true  = the app workspace is seeded with the synthetic demo dataset and
#         scans use the fixture scanner (no real URLs are ever requested).
# false = normal operation: imports and scans act on your real campaign data.
DEMO_MODE=false

# Gates real URL scanning on the public demo routes (scope=demo).
# false = demo routes always use synthetic fixtures.
# Only enable after reading SECURITY.md — rate-limit and authenticate first.
PUBLIC_SCANNER_ENABLED=false

# ------------------------------------------------------------------
# Scanner limits (server-only, positive integers)
# ------------------------------------------------------------------
# Defaults shown. Leave them as-is unless you have read DEPLOYMENT.md.
SCAN_MAX_TARGETS=25          # destinations per scan (spend-ranked)
SCAN_CONCURRENCY=5           # simultaneous destination requests
SCAN_TIMEOUT_MS=10000        # per-request timeout
SCAN_MAX_REDIRECTS=5         # redirect hops followed before stopping
SCAN_MAX_BODY_BYTES=2097152  # 2 MB HTML cap per response
SCAN_SLOW_RESPONSE_MS=3000   # responses slower than this are flagged

# ------------------------------------------------------------------
# White-label branding fallbacks (NEXT_PUBLIC_ — inlined at build time)
# ------------------------------------------------------------------
# Database branding (Settings → White-label branding) takes precedence
# over these. See BRANDING.md for the full precedence rules.
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_AGENCY_NAME=
NEXT_PUBLIC_ACCENT_COLOR=

# ------------------------------------------------------------------
# Marketing site (NEXT_PUBLIC_ — inlined at build time)
# ------------------------------------------------------------------
# Your payment/checkout link for the marketing site's Buy button.
# When unset the button is hidden and a plain note is shown instead.
NEXT_PUBLIC_CHECKOUT_URL=

# Optional portfolio link shown in the marketing footer ("Built by …").
NEXT_PUBLIC_PORTFOLIO_URL=

# ------------------------------------------------------------------
# Support contact (server-only; used as the branding support-email fallback)
# ------------------------------------------------------------------
SUPPORT_EMAIL=
