# LandingSentinel — environment configuration
#
# Copy this file to .env.local (development) or .env (self-hosted
# production), or set the variables in your host's dashboard (Vercel):
#   cp .env.example .env.local
#
# Full documentation for every variable: CONFIGURATION.md
#
# Precedence (Next.js convention, also used by the db:* scripts and tests):
#   real environment variables → .env.local → .env
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the client build —
# changing them requires a rebuild (npm run build). Server-only
# variables are read at runtime.

# ------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------
# PostgreSQL connection string. PostgreSQL is the canonical database:
# the schema ships with the postgresql provider and committed
# migrations (npm run db:migrate applies them). SQLite is not
# supported in the commercial package.
DATABASE_URL=postgresql://user:password@host:5432/landingsentinel

# ------------------------------------------------------------------
# Access control (server-only)
# ------------------------------------------------------------------
# "auth" (default): every route operating on the primary (real)
#   workspace requires an administrator session. The synthetic demo
#   workspace stays public. See SECURITY.md.
# "open": disables auth entirely — escape hatch for trusted/private
#   networks only. Any other value falls back to "auth".
APP_ACCESS_MODE=auth

# Administrator password hash (scrypt). Generate with:
#   npm run hash-password
# (minimum 10 characters; the plaintext password is never stored).
# Format: scrypt:N:r:p:<salt hex>:<hash hex> — colon-separated on
# purpose, because "$" separators get mangled by dotenv-expand.
# Required whenever APP_ACCESS_MODE=auth (the default).
ADMIN_PASSWORD_HASH=

# Session lifetime in hours. Default 168 = 7 days.
ADMIN_SESSION_TTL_HOURS=168

# ------------------------------------------------------------------
# Runtime modes (server-only)
# ------------------------------------------------------------------
# true  = the app workspace is seeded with the synthetic demo dataset and
#         scans use the fixture scanner (no real URLs are ever requested).
# false = normal operation: imports and scans act on your real campaign data.
DEMO_MODE=false

# Gates real URL scanning on the public demo routes (scope=demo).
# false = demo routes always use synthetic fixtures.
# Only enable after reading SECURITY.md — rate-limit and authenticate first.
PUBLIC_SCANNER_ENABLED=false

# ------------------------------------------------------------------
# Scanner limits (server-only, positive integers)
# ------------------------------------------------------------------
# Defaults shown. Leave them as-is unless you have read DEPLOYMENT.md.
SCAN_MAX_TARGETS=25          # destinations per scan (spend-ranked)
SCAN_CONCURRENCY=5           # simultaneous destination requests
SCAN_TIMEOUT_MS=10000        # per-request timeout
SCAN_MAX_REDIRECTS=5         # redirect hops followed before stopping
SCAN_MAX_BODY_BYTES=2097152  # 2 MB HTML cap per response
SCAN_SLOW_RESPONSE_MS=3000   # responses slower than this are flagged
SCAN_MAX_DURATION_MS=55000   # whole-scan deadline (fits the 60s route limit)

# TEST / DEVELOPMENT ONLY — never enable in production.
# When true, relaxes ONLY loopback targets (the "localhost" hostname,
# 127.0.0.0/8 and ::1) so the scanner can reach local fixture servers
# (npm run fixtures, integration tests). Cloud metadata, private
# ranges, link-local and every other SSRF rule stay enforced.
# Default false.
SCANNER_ALLOW_LOOPBACK_TARGETS=false

# ------------------------------------------------------------------
# White-label branding fallbacks (NEXT_PUBLIC_ — inlined at build time)
# ------------------------------------------------------------------
# Database branding (Settings → White-label branding) takes precedence
# over these. See BRANDING.md for the full precedence rules.
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_AGENCY_NAME=
NEXT_PUBLIC_ACCENT_COLOR=

# ------------------------------------------------------------------
# Marketing site (NEXT_PUBLIC_ — inlined at build time)
# ------------------------------------------------------------------
# Your payment/checkout link for the marketing site's Buy button.
# When unset, production hides the Buy button (licence CTA only) and
# development shows a configuration note — never a dead link.
NEXT_PUBLIC_CHECKOUT_URL=

# Optional portfolio link shown in the marketing footer ("Built by …").
NEXT_PUBLIC_PORTFOLIO_URL=

# One-page public checker (the "Scan one landing page" sales tool).
# true (default): the homepage shows the CTA and /api/public/scan answers
#   anonymous visitors — rate-limited to 3 evaluations per IP per hour,
#   SSRF-hardened, fully ephemeral (nothing is stored).
# false: the CTA is hidden and the route is disabled.
NEXT_PUBLIC_PAGE_CHECK_ENABLED=

# ------------------------------------------------------------------
# Site URL (NEXT_PUBLIC_ — used for metadata only, server-side)
# ------------------------------------------------------------------
# The canonical public URL of this deployment, e.g.
#   https://landingsentinel.vercel.app  or  https://preflight.your-agency.com
# Used to build absolute Open Graph / Twitter card image URLs, the
# canonical link and the sitemap/robots references. On Vercel the
# deployment URL is picked up automatically when this is unset; in
# development http://localhost:3000 is used; in self-hosted production
# with no value configured, absolute-URL metadata is simply omitted
# rather than pointing at a domain that does not exist.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------
# Support contact (server-only; used as the branding support-email fallback)
# ------------------------------------------------------------------
SUPPORT_EMAIL=
